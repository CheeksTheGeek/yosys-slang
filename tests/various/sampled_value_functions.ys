design -reset
read_slang <<EOF
module top(input logic clk, input logic [7:0] data);
	logic [7:0] delayed;
	always_ff @(posedge clk) begin
		delayed <= $past(data);
	end
endmodule
EOF
select -assert-count 1 t:$dffe

design -reset
read_slang <<EOF
module top(input logic clk, input logic [3:0] data);
	logic [3:0] delayed;
	always_ff @(posedge clk) begin
		delayed <= $past(data, 3);
	end
endmodule
EOF
select -assert-count 3 t:$dffe

design -reset
read_slang <<EOF
module top(input logic clk, input logic enable, input logic [7:0] data);
	logic [7:0] result;
	always_ff @(posedge clk) begin
		result <= $past(data, 1, enable);
	end
endmodule
EOF
select -assert-count 1 t:$dffe

design -reset
read_slang <<EOF
module top(input logic clk, input logic sig);
	logic result;
	always_ff @(posedge clk) begin
		result <= $rose(sig);
	end
endmodule
EOF
select -assert-count 1 t:$dffe
select -assert-count 1 t:$logic_and

design -reset
read_slang <<EOF
module top(input logic clk, input logic sig);
	logic result;
	always_ff @(posedge clk) begin
		result <= $fell(sig);
	end
endmodule
EOF
select -assert-count 1 t:$dffe
select -assert-count 1 t:$logic_and

design -reset
read_slang <<EOF
module top(input logic clk, input logic [7:0] data);
	logic result;
	always_ff @(posedge clk) begin
		result <= $stable(data);
	end
endmodule
EOF
select -assert-count 1 t:$dffe
select -assert-count 1 t:$eq

design -reset
read_slang <<EOF
module top(input logic clk, input logic [7:0] data);
	logic result;
	always_ff @(posedge clk) begin
		result <= $changed(data);
	end
endmodule
EOF
select -assert-count 1 t:$dffe
select -assert-count 1 t:$eq

design -reset
read_slang <<EOF
module top(input logic clk, input logic [7:0] data);
	logic [7:0] result;
	always_ff @(posedge clk) begin
		result <= $sampled(data);
	end
endmodule
EOF
select -assert-count 0 t:$dffe w:*past* %i

design -reset
read_slang <<EOF
module top(input logic clk, input logic enable, input logic [7:0] data);
	logic [7:0] past_data;
	logic enable_rose, enable_fell, data_stable, data_changed;
	always_ff @(posedge clk) begin
		past_data <= $past(data);
		enable_rose <= $rose(enable);
		enable_fell <= $fell(enable);
		data_stable <= $stable(data);
		data_changed <= $changed(data);
	end
endmodule
EOF
select -assert-count 2 t:$dffe
select -assert-count 2 t:$logic_and
select -assert-count 2 t:$eq

design -reset
read_slang <<EOF
module top(input logic clk, input logic [7:0] data);
	logic [7:0] result1, result2;
	always_ff @(posedge clk) begin
		result1 <= $past(data);
		result2 <= $past(data, 2);
	end
endmodule
EOF
select -assert-count 3 t:$dffe
